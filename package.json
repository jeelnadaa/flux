{
  "name": "flux",
  "version": "2.0.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "sidecar": "node scripts/sidecar.mjs",
    "app:dev": "node scripts/sidecar.mjs && tauri dev --config apps/desktop/src-tauri/tauri.conf.json",
    "app:build": "node scripts/sidecar.mjs && tauri build --config apps/desktop/src-tauri/tauri.conf.json",
    "build:static": "node scripts/build-static.mjs",
    "test:ui": "node --test tests/ui/*.test.mjs",
    "test:site": "node --test tests/site/*.test.mjs",
    "check:js": "node scripts/check-js.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0"
  }
}
