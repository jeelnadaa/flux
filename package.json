    "test:unit": "node --test packages/app-core/dist/timeline/__tests__/*.test.js packages/app-core/dist/editing/__tests__/*.test.js packages/app-core/dist/project/__tests__/*.test.js packages/app-core/dist/input/__tests__/*.test.js packages/app-core/dist/effects/__tests__/*.test.js packages/app-core/dist/tempo/__tests__/*.test.js packages/app-core/dist/restoration/__tests__/*.test.js packages/app-core/dist/utility/__tests__/*.test.js packages/app-core/dist/spatial/__tests__/*.test.js packages/app-core/dist/creative/__tests__/*.test.js packages/app-core/dist/ai/__tests__/*.test.js packages/app-core/dist/platform/__tests__/*.test.js packages/app-core/dist/state/__tests__/*.test.js packages/app-core/dist/workflow/__tests__/*.test.js packages/app-core/dist/hardening/__tests__/*.test.js packages/ui/dist/__tests__/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "license:check": "license-checker-rseidelsohn --onlyAllow \"MIT;ISC;Apache-2.0;BlueOak-1.0.0;BSD-2-Clause;BSD-3-Clause;Python-2.0;CC-BY-3.0;CC0-1.0;0BSD;Unlicense;(MIT AND CC-BY-3.0);MIT OR Apache-2.0\" --excludePrivatePackages"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.22.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.26.0"
  },
  "dependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
