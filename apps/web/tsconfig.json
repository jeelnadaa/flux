{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@flux/ui": ["../../packages/ui/src/index.ts"],
      "@flux/app-core": ["../../packages/app-core/src/index.ts"]
    },
    "strict": true,
    "skipLibCheck": true
  },
  "references": [
    { "path": "../../packages/ui" },
    { "path": "../../packages/app-core" }
  ],
  "include": ["src/**/*"]
}
