{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flux",
  "version": "2.0.0",
  "identifier": "app.flux.editor",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Flux",
        "width": 1440,
        "height": 900,
        "minWidth": 390,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "appimage", "deb", "rpm"],
    "createUpdaterArtifacts": true,
    "publisher": "Flux Contributors",
    "category": "Music",
    "shortDescription": "Non-destructive audio editor",
    "longDescription": "Flux is a non-destructive audio editor that runs on your computer. Edit, clean, mix, master and export, with every feature also available to AI agents over MCP.",
    "copyright": "Flux Contributors. MIT OR Apache-2.0.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/flux-mcp"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": { "depends": [] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczRjRBMzQwN0E1MEFEQTUKUldTbHJWQjZRS1AwYzE3WC9XN2JFcWhtK1ZOc0dYd2xMVE1kbVpjMUU4WjBFY1VJdmVZRldaaWUK",
      "endpoints": ["https://github.com/jeelnadaa/flux/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
