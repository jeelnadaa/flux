# Auto-detect text files and normalize line endings to LF in repository
* text=auto eol=lf

# Explicit text files
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.py text eol=lf
Justfile text eol=lf
justfile text eol=lf

# Binary files
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wasm binary
*.sofa binary
*.wav binary
*.flac binary
*.mp3 binary
*.onnx binary
